    "db:migration:push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:types:gen": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema app_core > src/shared/infrastructure/supabase/database.types.ts"
  },
